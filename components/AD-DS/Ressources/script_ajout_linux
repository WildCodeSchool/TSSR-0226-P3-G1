#!/bin/bash
# =============================================================
#  Script de jonction Active Directory — Debian 13 / Ubuntu 24
#  Usage : sudo bash join_ad.sh
# =============================================================

# ─────────────────────────────────────────────────────────────
#  VARIABLES — À ADAPTER À TON ENVIRONNEMENT
# ─────────────────────────────────────────────────────────────
DOMAIN="BILLU.LAN"           # Nom du domaine AD (MAJUSCULES)
DOMAIN_LOWER="billu.lan"     # Nom du domaine (minuscules)
AD_IP="172.16.130.253"                # IP du serveur AD/DNS
AD_ADMIN="DLGUSER01"           # Compte admin AD pour joindre le domaine
AD_GROUP="GRP_ADMIN_LINUX"          # Groupe AD autorisé à se connecter (laisser vide = tout le domaine)
HOMEDIR_BASE="/home"                # Répertoire de base pour les homes AD

# ─────────────────────────────────────────────────────────────
#  FONCTIONS UTILITAIRES
# ─────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()    { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

check_root() {
    [ "$EUID" -eq 0 ] || error "Ce script doit être exécuté en root (sudo)"
}

# ─────────────────────────────────────────────────────────────
#  1. VÉRIFICATIONS PRÉALABLES
# ─────────────────────────────────────────────────────────────
check_root

info "=== Vérifications préalables ==="

# Vérifier la connectivité vers l'AD
ping -c 2 "$AD_IP" > /dev/null 2>&1 || error "Impossible de joindre le serveur AD ($AD_IP). Vérifie le réseau."
info "Serveur AD joignable ✓"

# ─────────────────────────────────────────────────────────────
#  2. CONFIGURATION DNS
# ─────────────────────────────────────────────────────────────
info "=== Configuration DNS ==="

# Pointer vers le serveur AD pour la résolution DNS
if [ -f /etc/systemd/resolved.conf ]; then
    # Systèmes avec systemd-resolved (Ubuntu 24)
    cat > /etc/systemd/resolved.conf <<EOF
[Resolve]
DNS=$AD_IP
Domains=$DOMAIN_LOWER
FallbackDNS=8.8.8.8
EOF
    systemctl restart systemd-resolved
    info "systemd-resolved configuré ✓"
else
    # Fallback /etc/resolv.conf
    cat > /etc/resolv.conf <<EOF
nameserver $AD_IP
search $DOMAIN_LOWER
EOF
    info "/etc/resolv.conf configuré ✓"
fi

# Vérifier la résolution du domaine
sleep 2
nslookup "$DOMAIN_LOWER" "$AD_IP" > /dev/null 2>&1 || warn "Résolution DNS du domaine échouée — vérifie la config DNS"
info "Résolution DNS OK ✓"

# ─────────────────────────────────────────────────────────────
#  3. INSTALLATION DES PAQUETS
# ─────────────────────────────────────────────────────────────
info "=== Installation des paquets ==="

apt-get update -qq || error "Échec de apt-get update"

apt-get install -y \
    realmd \
    sssd \
    sssd-tools \
    libnss-sss \
    libpam-sss \
    adcli \
    samba-common-bin \
    oddjob \
    oddjob-mkhomedir \
    krb5-user \
    packagekit || error "Échec de l'installation des paquets"

info "Paquets installés ✓"

# ─────────────────────────────────────────────────────────────
#  4. DÉCOUVERTE ET JONCTION AU DOMAINE
# ─────────────────────────────────────────────────────────────
info "=== Jonction au domaine $DOMAIN ==="

# Découverte du domaine
realm discover "$DOMAIN_LOWER" || error "Impossible de découvrir le domaine $DOMAIN_LOWER"

# Jonction au domaine (demande le mot de passe admin AD)
info "Entrez le mot de passe du compte $AD_ADMIN@$DOMAIN :"
realm join --user="$AD_ADMIN" "$DOMAIN_LOWER" || error "Échec de la jonction au domaine"

info "Jonction au domaine réussie ✓"

# ─────────────────────────────────────────────────────────────
#  5. CONFIGURATION SSSD
# ─────────────────────────────────────────────────────────────
info "=== Configuration SSSD ==="

cat > /etc/sssd/sssd.conf <<EOF
[sssd]
domains = $DOMAIN_LOWER
config_file_version = 2
services = nss, pam

[domain/$DOMAIN_LOWER]
ad_domain = $DOMAIN_LOWER
krb5_realm = $DOMAIN
realmd_tags = manages-system joined-with-adcli
cache_credentials = True
id_provider = ad
auth_provider = ad
access_provider = ad
krb5_store_password_if_offline = True

# Connexion sans suffixe de domaine (user au lieu de user@domaine)
use_fully_qualified_names = False

# Répertoire home automatique
fallback_homedir = $HOMEDIR_BASE/%u

# Optimisations de performance
ldap_id_use_start_tls = True
ldap_referrals = False
enumerate = False

# Timeout de cache (en secondes)
entry_cache_timeout = 3600
krb5_renewable_lifetime = 7d
krb5_renew_interval = 1h
EOF

chmod 600 /etc/sssd/sssd.conf
info "sssd.conf configuré ✓"

# ─────────────────────────────────────────────────────────────
#  6. CRÉATION AUTOMATIQUE DU HOME DIRECTORY
# ─────────────────────────────────────────────────────────────
info "=== Configuration mkhomedir (création automatique du /home) ==="

pam-auth-update --enable mkhomedir
info "mkhomedir activé ✓"

# ─────────────────────────────────────────────────────────────
#  7. RESTRICTION D'ACCÈS PAR GROUPE AD
# ─────────────────────────────────────────────────────────────
info "=== Restriction d'accès ==="

if [ -n "$AD_GROUP" ]; then
    realm permit -g "$AD_GROUP"
    info "Accès restreint au groupe AD : $AD_GROUP ✓"
else
    realm permit --all
    warn "Accès autorisé à tout le domaine (aucun groupe restreint)"
fi

# ─────────────────────────────────────────────────────────────
#  8. CONFIGURATION SSH (optionnel mais recommandé)
# ─────────────────────────────────────────────────────────────
info "=== Sécurisation SSH ==="

# Backup du sshd_config original
cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak

# Activer l'auth via SSSD/Kerberos dans SSH
sed -i 's/^#\?GSSAPIAuthentication.*/GSSAPIAuthentication yes/' /etc/ssh/sshd_config
sed -i 's/^#\?GSSAPICleanupCredentials.*/GSSAPICleanupCredentials yes/' /etc/ssh/sshd_config

# S'assurer que UsePAM est activé (nécessaire pour SSSD)
sed -i 's/^#\?UsePAM.*/UsePAM yes/' /etc/ssh/sshd_config

info "SSH configuré pour SSSD/Kerberos ✓"

# ─────────────────────────────────────────────────────────────
#  9. DÉMARRAGE ET ACTIVATION DES SERVICES
# ─────────────────────────────────────────────────────────────
info "=== Démarrage des services ==="

systemctl enable --now sssd
systemctl enable --now oddjobd
systemctl restart sssd
systemctl restart sshd

info "Services démarrés ✓"

# ─────────────────────────────────────────────────────────────
#  10. VÉRIFICATIONS FINALES
# ─────────────────────────────────────────────────────────────
info "=== Vérifications finales ==="

sleep 3

# Vérifier le statut realm
echo ""
echo "── Statut du domaine ──────────────────────"
realm list

# Vérifier SSSD
echo ""
echo "── Statut SSSD ────────────────────────────"
systemctl is-active sssd && info "SSSD actif ✓" || warn "SSSD inactif !"

# Test de résolution d'un utilisateur AD
echo ""
echo "── Test résolution utilisateur AD ─────────"
echo "Entrez un nom d'utilisateur AD à tester (ou Entrée pour passer) :"
read -r TEST_USER
if [ -n "$TEST_USER" ]; then
    id "$TEST_USER" && info "Utilisateur $TEST_USER reconnu ✓" || warn "Utilisateur $TEST_USER non trouvé"
fi

echo ""
info "=== Script terminé avec succès ! ==="
echo ""
echo "  Connexion SSH possible avec :"
echo "  ssh ${TEST_USER:-utilisateur_ad}@$(hostname)"
echo ""
echo "  En cas de problème, consulter les logs :"
echo "  journalctl -u sssd -f"
echo ""
